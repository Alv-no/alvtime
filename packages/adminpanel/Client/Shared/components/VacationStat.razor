@namespace Alvtime.Adminpanel.Client.Shared.Components

<div style="min-width: 10rem; @(OnClick.HasDelegate ? "cursor:pointer;" : "")" @onclick="OnClick">
    <MudText Typo="Typo.h4" Color="@(Active ? Color.Primary : Accent)">@Value</MudText>
    <MudText Typo="Typo.body2" Class="@(Active ? "" : "mud-text-secondary")">@Label</MudText>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public Color Accent { get; set; } = Color.Default;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Active { get; set; }
}
