@namespace Alvtime.Adminpanel.Client.Shared.Components

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
            <div class="d-flex justify-space-between gap-4 py-1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Omfang</MudText>
                <MudText Typo="Typo.body2" Style="text-align: right;">
                    <b>Alle kunder, også de uten timer siste 2 måneder</b>
                </MudText>
            </div>
            <div class="d-flex justify-space-between gap-4 py-1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Holdes åpne</MudText>
                <MudText Typo="Typo.body2" Style="text-align: right;"><b>@ExcludedSummary</b></MudText>
            </div>
        </MudPaper>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Ansatte kan ikke endre eller slette låste timer. Enkeltkunder kan få en ny låsedato etterpå.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton
            Color="Color.Tertiary"
            Variant="Variant.Filled"
            OnClick="@Cancel">
            <TextAdjuster>Avbryt</TextAdjuster>
        </MudButton>
        <MudButton
            Color="Color.Secondary"
            Variant="Variant.Filled"
            OnClick="@Confirm">
            <TextAdjuster>Lås timer</TextAdjuster>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public List<string> ExcludedCustomerNames { get; set; } = [];

    private string ExcludedSummary => ExcludedCustomerNames.Count == 0
        ? "ingen"
        : string.Join(", ", ExcludedCustomerNames);

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
