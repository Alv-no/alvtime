@page "/ansatte/{EmployeeId}"
@using Alvtime.Adminpanel.Client.ErrorHandling
@using Alvtime.Adminpanel.Client.Models
@using Alvtime.Adminpanel.Client.Resources
@using Alvtime.Adminpanel.Client.Shared.components
@using Alvtime.Adminpanel.Client.Utils
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedContentStrings> Localizer

@if (_employee is not null)
{
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudIconButton
                Icon="@Icons.Material.Filled.ArrowBack"
                Color="Color.Secondary"
                aria-label="back"
                OnClick="@(()=> Navigation.NavigateTo("/ansatte"))"/>
            <PageTitle>@_employee.Name ?? @Localizer["EmployeePage.Details"]</PageTitle>

            <MudPaper Class="mb-4 d-flex flex-row align-center" Elevation="0">
                <MudText Class="me-2" Typo="Typo.h2">@_employee.Name</MudText>
                <MudIconButton
                    Icon="@Icons.Material.Filled.Edit"
                    Color="Color.Secondary"
                    OnClick="@EditEmployee">
                </MudIconButton>
            </MudPaper>

            <div class="d-flex flex-column flex-sm-row gap-16 mb-8">
                <MudPaper Class="pa-4" Elevation="0">
                    @if (_employee is null)
                    {
                    // insert avatar image
                    <MudAvatar Color="Color.Secondary" Style="width: 250px; height: 250px;">

                    </MudAvatar>
                    }
                    else
                    {
                    // insert placeholder avatar
                    <MudAvatar Elevation="2" Color="Color.Secondary" Style="width: 250px; height: 250px;">
                        @if (string.IsNullOrEmpty(_employee.ProfilePicture))
                        {
                            <MudText Typo="Typo.button" Style="font-size: 2rem;">@TextUtilities.GetInitialsFromName(_employee.Name, null)</MudText>
                        }
                        else
                        {
                            <img src="data:image/jpeg;base64,@_employee.ProfilePicture" alt="@($"Profile picture of {_employee.Name}")" style="width: 100%; height: 100%; object-fit: cover;"/>
                        }
                    </MudAvatar>
                    }
                </MudPaper>
            </div>
            <MudPaper Elevation="0" Class="pa-4">
                <MudText
                >
                    @Localizer["Common.StartDate"]: @(_employee.StartDate.HasValue ? _employee.StartDate.Value.ToString("dd.MM.yyyy") : "")
                </MudText>
                <MudText
                >
                    @Localizer["Common.EndDate"]: @(_employee.EndDate.HasValue ? _employee.EndDate.Value.ToString("dd.MM.yyyy") : "")
                </MudText>
                <MudText>
                    @Localizer["Common.Email"]: @_employee.Email
                </MudText>
                <MudText>
                    @Localizer["Common.EmployeeId"]: @_employee.EmployeeId
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                    <MudText>
                        @Localizer["Common.SalaryModel"]: @Localizer[$"EmployeePage.SalaryModel.{_employee.SalaryModel}"]
                    </MudText>
                    <MudTooltip Text="@SalaryModelChangeTooltip">
                        <MudIconButton
                            Icon="@Icons.Material.Filled.Edit"
                            Size="Size.Small"
                            Color="Color.Secondary"
                            Disabled="@(!CanChangeSalaryModel)"
                            OnClick="@ChangeSalaryModel"/>
                    </MudTooltip>
                </MudStack>
                @if (_employee.PendingSalaryModelChange is not null)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-2" Variant="Variant.Outlined">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText>
                                @string.Format(
                                    Localizer["EmployeePage.SalaryModel.Pending.Banner"],
                                    Localizer[$"EmployeePage.SalaryModel.{_employee.PendingSalaryModelChange.NewModel}"],
                                    _employee.PendingSalaryModelChange.EffectiveDate.ToString("dd.MM.yyyy"))
                            </MudText>
                            <MudButton
                                Variant="Variant.Text"
                                Color="Color.Secondary"
                                OnClick="@CancelPendingSalaryModelChange"
                                Disabled="@(_employee.StartDate > DateTime.Today)">
                                @Localizer["EmployeePage.SalaryModel.Pending.Cancel"]
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }
                @if (_employee.SalaryModelHistory is { Count: > 0 })
                {
                    <MudButton
                        Variant="Variant.Text"
                        Size="Size.Small"
                        Class="mt-2"
                        OnClick="@(() => _showHistory = !_showHistory)">
                        @(_showHistory ? Localizer["EmployeePage.SalaryModel.History.Hide"] : Localizer["EmployeePage.SalaryModel.History.Show"])
                    </MudButton>
                    @if (_showHistory)
                    {
                        <MudSimpleTable Class="mt-2" Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>@Localizer["EmployeePage.SalaryModel.History.SwitchDate"]</th>
                                    <th>@Localizer["EmployeePage.SalaryModel.History.PreviousModel"]</th>
                                    <th>@Localizer["EmployeePage.SalaryModel.History.NewModel"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _employee.SalaryModelHistory)
                                {
                                    <tr>
                                        <td>@entry.SwitchDate.ToString("dd.MM.yyyy")</td>
                                        <td>@Localizer[$"EmployeePage.SalaryModel.{entry.PreviousModel}"]</td>
                                        <td>@Localizer[$"EmployeePage.SalaryModel.{entry.NewModel}"]</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="mb-4">
                <MudDataGrid
                    T="EmployeeEmploymentRateModel"
                    Items="_employee.EmploymentRates"
                    MultiSelection="@_multiSelection"
                    @bind-selectedItem="_selectedEmploymentRate"
                    @bind-SelectedItems="_employmentRateSelectionList"
                    Filterable="false"
                    FooterClass="d-none">
                    <ToolBarContent>
                        <MudText Class="mb-2" Typo="Typo.h6">@Localizer["Common.EmploymentRate"]</MudText>
                        <MudSpacer/>
                        <MudIconButton
                            Icon="@Icons.Material.Filled.Add"
                            Color="Color.Secondary"
                            OnClick="@AddNewEmploymentRate"
                            aria-label="@Localizer["CustomerPage.AddProject"]">
                        </MudIconButton>
                        <MudIconButton
                            Icon="@Icons.Material.Filled.Edit"
                            Color="Color.Secondary"
                            OnClick="@EditEmploymentRate"
                            Disabled="@(_selectedEmploymentRate == null)"
                            aria-label="@Localizer["CustomerPage.EditProject"]">
                        </MudIconButton>
                    </ToolBarContent>
                    <Columns>
                        <SelectColumn
                            T="EmployeeEmploymentRateModel"
                            ShowInHeader="false"
                        />
                        <PropertyColumn
                            Title="@Localizer["Common.StartDate.Inclusive"]"
                            Property="r => r.FromDateInclusive"
                            Format="d"
                        />
                        <PropertyColumn
                            Title="@Localizer["Common.EndDate.Inclusive"]"
                            Property="r=> r.ToDateInclusive"
                            Format="d"
                        />
                        <PropertyColumn
                            Title="@Localizer["Common.EmploymentRate"]"
                            Property="r=>r.RatePercentage"
                        />
                    </Columns>
                </MudDataGrid>
            </MudPaper>
        </Authorized>
        <NotAuthorized>Du har ikke tilgang til å se dette innholdet.</NotAuthorized>
    </AuthorizeView>
}
else
{
    
}

@code {
    [Inject] private HttpClient HttpClient { get; set; }
    [Inject] public HttpInterceptorService Interceptor { get; set; }
    [Inject] private IDialogService DialogService { get; set; }
    [Inject] NavigationManager Navigation { get; set; }
    
    [Parameter] public string EmployeeId { get; set; }

    private EmployeeModel? _employee;
    
    /* All off this need to be like this, to prevent the UI to allow multiselect. Who knows why it is like that. 🤷‍♂️ */
    private readonly bool _multiSelection = false;
    private HashSet<EmployeeEmploymentRateModel> _employmentRateSelectionList = [];
    private EmployeeEmploymentRateModel? _selectedEmploymentRate;
    private bool _showHistory;
    
    protected override async Task OnInitializedAsync()
    {
        // Fetch data for customer
        Interceptor.RegisterEvent();
        await RefreshEmployee();
    }

    private async Task RefreshEmployee()
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            _employee = null;
            return;
        }

        try
        {
            var employeeResponse = await HttpClient.GetAsync(ApiRoutes.GetEmployeeById(parsedId));

            if (employeeResponse.IsSuccessStatusCode)
            {
                _employee = await employeeResponse.Content.ReadFromJsonAsync<EmployeeModel>();
            }
            else
            {
                
            }
        }
        catch (HttpRequestException e)
        {
            // Handle network errors
            Console.WriteLine($"Network error: {e.Message}");
        }
    }

    private void EditEmployee()
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            return;
        }
        
        DialogService.ShowAsync<EmployeeDialog>(@Localizer["EmployeePage.EditEmployee"], new DialogParameters
            {
                ["OnEmployeeSubmit"] = RefreshAfterDialogAction,
                ["EmployeeId"] = parsedId,
                ["CurrentEmployeeData"] = _employee
            },
            new DialogOptions()
            {
                FullWidth = true, 
                MaxWidth = MaxWidth.Small
            });
    }
    
    private EventCallback RefreshAfterDialogAction => new(this, (Action)(async () =>
    {
        await RefreshEmployee();
        StateHasChanged();
    }));
    
    private void ChangeSalaryModel()
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            return;
        }

        DialogService.ShowAsync<SalaryModelDialog>(@Localizer["EmployeePage.ChangeSalaryModel"], new DialogParameters
            {
                ["OnSalaryModelSubmit"] = RefreshAfterDialogAction,
                ["EmployeeId"] = parsedId,
                ["CurrentSalaryModel"] = _employee!.SalaryModel,
                ["PendingChange"] = _employee.PendingSalaryModelChange
            },
            new DialogOptions()
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            });
    }

    private bool CanChangeSalaryModel
    {
        get
        {
            if (_employee is null) return false;
            var today = DateTime.Today;
            if (today.Month >= 7) return false;
            var thisYearJune1 = new DateTime(today.Year, 6, 1);
            if (today >= thisYearJune1
                && _employee.SalaryModelHistory is not null
                && _employee.SalaryModelHistory.Any(h =>
                    h.SwitchDate.Year == today.Year && h.PreviousModel != h.NewModel))
            {
                return false;
            }
            return true;
        }
    }

    private string? SalaryModelChangeTooltip
    {
        get
        {
            if (_employee is null || CanChangeSalaryModel) return null;
            var today = DateTime.Today;
            if (today.Month >= 7)
                return Localizer["EmployeePage.SalaryModel.CannotChange.OutsideWindow"];
            return Localizer["EmployeePage.SalaryModel.CannotChange.AlreadyChanged"];
        }
    }

    private async Task CancelPendingSalaryModelChange()
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            return;
        }

        await HttpClient.DeleteAsync(ApiRoutes.CancelPendingSalaryModelChange(parsedId));
        await RefreshEmployee();
    }

    private void AddNewEmploymentRate(MouseEventArgs obj)
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            return;
        }
        
        DialogService.ShowAsync<EmploymentRateDialog>(@Localizer["EmployeePage.AddEmploymentRate"], new DialogParameters
            {
                ["OnEmploymentRateSubmit"] = RefreshAfterDialogAction,
                ["EmployeeId"] = parsedId
                
            },
            new DialogOptions()
            {
                FullWidth = true, 
                MaxWidth = MaxWidth.Small
            });
    }

    private void EditEmploymentRate(MouseEventArgs obj)
    {
        if (string.IsNullOrEmpty(EmployeeId) || !int.TryParse(EmployeeId, out int parsedId))
        {
            return;
        }
        
        DialogService.ShowAsync<EmploymentRateDialog>(@Localizer["EmployeePage.EditEmploymentRate"], new DialogParameters
            {
                ["OnEmploymentRateSubmit"] = RefreshAfterDialogAction,
                ["EmployeeId"] = parsedId,
                ["CurrentEmploymentRateData"] = _selectedEmploymentRate
            },
            new DialogOptions()
            {
                FullWidth = true, 
                MaxWidth = MaxWidth.Small
            });
    }

}