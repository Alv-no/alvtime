@page "/ferie/{EmployeeId}"
@using System.Globalization
@using Alvtime.Adminpanel.Client.Models
@using Alvtime.Adminpanel.Client.Utils
@using Alvtime.Adminpanel.Client.ErrorHandling
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<PageTitle>@(_employee?.Name ?? "Ferie")</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <MudIconButton
            Icon="@Icons.Material.Filled.ArrowBack"
            Color="Color.Secondary"
            aria-label="back"
            OnClick="@(() => Navigation.NavigateTo("/ferie"))"/>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="my-4"/>
        }
        else if (_employee is null)
        {
            <MudText Typo="Typo.h2">Fant ikke ansatt</MudText>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-2">
                <MudAvatar Color="Color.Secondary" Style="width: 78px; height: 78px;">
                    @if (!string.IsNullOrEmpty(_employee.ProfilePicture))
                    {
                        <img src="data:image/jpeg;base64,@_employee.ProfilePicture" alt="" style="width: 100%; height: 100%; object-fit: cover;"/>
                    }
                    else
                    {
                        <MudText Typo="Typo.button" Style="font-size: 1.6rem;">@TextUtilities.GetInitialsFromName(_employee.Name, null)</MudText>
                    }
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h2">@_employee.Name</MudText>
                </div>
            </MudStack>

            @if (_vacation is null)
            {
                <MudPaper Elevation="0" Class="pa-8" Style="text-align: center;">
                    <MudText Class="mud-text-secondary">Ingen ferie registrert for @_year.</MudText>
                </MudPaper>
            }
            else
            {
                <div class="d-flex flex-wrap gap-4 mb-4">
                    <StatTile Label="Tilgjengelig nå" Value="@Nd(_vacation.AvailableVacationDays)"
                              Sub="feriedager igjen"
                              Accent="@(_vacation.AvailableVacationDays <= 5 ? Color.Error : Color.Secondary)"/>
                    <StatTile Label="Brukt i år" Value="@Nd(_vacation.UsedVacationDaysThisYear)"
                              Sub="dager avviklet"/>
                    <StatTile Label="Planlagt i år" Value="@Nd(_vacation.PlannedVacationDaysThisYear)"
                              Sub="dager fremover"
                              Accent="@(_vacation.PlannedVacationDaysThisYear > 0 ? Color.Tertiary : Color.Default)"/>
                    <StatTile Label="Overført fra i fjor"
                              Value="@(_vacation.AvailableVacationDaysTransferredFromLastYear > 0 ? $"+{Nd(_vacation.AvailableVacationDaysTransferredFromLastYear)}" : "0")"
                              Sub="lagt til potten"/>
                </div>

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline" Class="mb-2">
                    <MudText Typo="Typo.h5">Registrerte feriedager</MudText>
                </MudStack>

                @if (_periods.Count == 0)
                {
                    <MudPaper Elevation="0" Class="pa-6">
                        <MudText Class="mud-text-secondary">Ingen ferie registrert for @_year.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (var p in _periods)
                        {
                            <MudExpansionPanel>
                                <TitleContent>
                                    <div class="d-flex align-center gap-4" style="width: 100%;">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(p.Status == PeriodStatus.Planned ? Color.Tertiary : Color.Secondary)"
                                                 Variant="@(p.Status == PeriodStatus.Planned ? Variant.Outlined : Variant.Filled)">
                                            @StatusLabel(p.Status)
                                        </MudChip>
                                        <MudText Typo="Typo.body1" Style="flex: 1;">@RangeLabel(p.From, p.To)</MudText>
                                        <MudText Typo="Typo.body1">
                                            <b>@Nd(p.Count)</b> @(p.Count == 1 ? "dag" : "dager")
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    @foreach (var d in p.Days)
                                    {
                                        <div class="d-flex align-center gap-4 py-1">
                                            <MudText Typo="Typo.body2" Style="width: 90px; text-transform: capitalize;">@d.Date.ToString("dddd", Nb)</MudText>
                                            <MudText Typo="Typo.body2" Style="width: 150px;"><b>@d.Date.ToString("dd. MMM yyyy", Nb)</b></MudText>
                                            @if (d.Half)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">½ dag</MudChip>
                                            }
                                            <MudSpacer/>
                                            <MudText Typo="Typo.caption"
                                                     Color="@(d.Status == PeriodStatus.Planned ? Color.Tertiary : Color.Secondary)">
                                                @StatusLabel(d.Status)
                                            </MudText>
                                        </div>
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }
        }
    </Authorized>
    <NotAuthorized>Du har ikke tilgang til å se dette innholdet.</NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private HttpClient HttpClient { get; set; }
    [Inject] public HttpInterceptorService Interceptor { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }

    [Parameter] public string EmployeeId { get; set; } = "";

    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");
    private readonly int _year = DateTime.Now.Year;

    private bool _loading = true;
    private EmployeeModel? _employee;
    private VacationDaysModel? _vacation;
    private List<VacationPeriod> _periods = [];

    private decimal Available => _vacation?.AvailableVacationDays ?? 0;
    private decimal Taken => _vacation?.UsedVacationDaysThisYear ?? 0;
    private decimal Planned => _vacation?.PlannedVacationDaysThisYear ?? 0;
    private decimal StartedWith => Available + Taken;

    protected override async Task OnInitializedAsync()
    {
        Interceptor.RegisterEvent();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (!int.TryParse(EmployeeId, out var id))
        {
            _loading = false;
            return;
        }

        try
        {
            var vacationTask = HttpClient.GetFromJsonAsync<List<VacationOverviewReportModel>>(ApiRoutes.VacationOverview(_year));
            var employeeTask = HttpClient.GetFromJsonAsync<EmployeeModel>(ApiRoutes.GetEmployeeById(id));
            await Task.WhenAll(vacationTask, employeeTask);

            _employee = await employeeTask;
            _vacation = (await vacationTask ?? []).FirstOrDefault(r => r.UserId == id)?.VacationDaysDto;

            if (_vacation is not null)
            {
                var all = _vacation.UsedTransactions.Concat(_vacation.PlannedTransactions);
                _periods = GroupPeriods(all);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<VacationPeriod> GroupPeriods(IEnumerable<VacationTransactionModel> entries)
    {
        var days = entries
            .Where(e => e.Value > 0)
            .OrderBy(e => e.Date)
            .Select(e => new VacationDay
            {
                Date = e.Date.Date,
                Half = e.Value < 7.5m,
                Amount = e.Value / 7.5m,
                Status = e.Date.Date <= DateTime.Today ? PeriodStatus.Taken : PeriodStatus.Planned
            })
            .ToList();

        var periods = new List<VacationPeriod>();
        foreach (var day in days)
        {
            var current = periods.LastOrDefault();
            var gap = current is null ? int.MaxValue : (day.Date - current.Days[^1].Date).Days;
            if (current is not null && gap <= 4)
            {
                current.Days.Add(day);
            }
            else
            {
                periods.Add(new VacationPeriod { Days = [day] });
            }
        }

        foreach (var p in periods)
        {
            p.From = p.Days[0].Date;
            p.To = p.Days[^1].Date;
            p.Count = p.Days.Sum(d => d.Amount);
            var statuses = p.Days.Select(d => d.Status).Distinct().ToList();
            p.Status = statuses.Count > 1 ? PeriodStatus.Mixed : statuses[0];
        }

        periods.Reverse();
        return periods;
    }

    private static string RangeLabel(DateTime from, DateTime to)
    {
        if (from == to) return from.ToString("d. MMMM yyyy", Nb);
        if (from.Month == to.Month && from.Year == to.Year)
            return $"{from.Day}.–{to.Day}. {to.ToString("MMMM yyyy", Nb)}";
        return $"{from.ToString("d. MMM", Nb)} – {to.ToString("d. MMM yyyy", Nb)}";
    }

    private static string StatusLabel(PeriodStatus status) => status switch
    {
        PeriodStatus.Planned => "Planlagt",
        PeriodStatus.Mixed => "Pågår",
        _ => "Brukt"
    };

    private static string Nd(decimal n) => Math.Round(n, 1).ToString("0.#", Nb);

    private enum PeriodStatus { Taken, Planned, Mixed }

    private class VacationDay
    {
        public DateTime Date { get; set; }
        public bool Half { get; set; }
        public decimal Amount { get; set; }
        public PeriodStatus Status { get; set; }
    }

    private class VacationPeriod
    {
        public DateTime From { get; set; }
        public DateTime To { get; set; }
        public decimal Count { get; set; }
        public PeriodStatus Status { get; set; }
        public List<VacationDay> Days { get; set; } = [];
    }
}
